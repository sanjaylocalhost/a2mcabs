---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import BookingForm from '../components/BookingForm.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import FleetGrid from '../components/FleetGrid.astro';
import JourneySection from '../components/JourneySection.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/whatsappfloating.astro';
---
<BaseLayout>
  <Header />
  <main>
    <Hero />
    <BookingForm />
    <ServiceGrid />
    <FleetGrid />
    <JourneySection />
    <HowItWorks />
    <CtaSection />
    <WhatsAppButton/>
  </main>

  <Footer />
</BaseLayout>















