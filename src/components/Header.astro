<header class="site-header">
  <a class="brand" href="/" aria-label="A2M Cabs home">
    <span class="brand-mark">A<span>2</span>M</span>
    <span class="brand-copy">CABS<span>MOVE A LITTLE GREENER</span></span>
  </a>
  <nav class="desktop-nav" aria-label="Main navigation">
    <a href="#services">Our services</a>
    <a href="#fleet">Our fleet</a>
    <a href="#journeys">Tour packages</a>
    <a href="#how">How it works</a>
  </nav>
  <div class="header-actions">
    <a class="login-link" href="/login/">Log in</a>
    <a class="button button-small" href="#booking">Book a ride <span>↗</span></a>
  </div>
  <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">☰</button>
</header>

<script>
  const menuButton = document.querySelector('.menu-toggle');
  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!open));
    document.querySelector('.desktop-nav')?.classList.toggle('nav-open', !open);
  });
</script>